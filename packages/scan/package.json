{
  "name": "@evolu/scan",
  "version": "0.0.1",
  "description": "Evolu Developer Tools",
  "keywords": [
    "react",
    "evolu-scan",
    "evolu scan",
    "render",
    "performance"
  ],
  "homepage": "https://evolu.dev",
  "bugs": {
    "url": "https://github.com/evoluhq/evolu-scan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoluhq/evolu-scan.git"
  },
  "license": "MIT",
  "author": "Daniel Steigerwald <daniel@steigerwald.cz>",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm run build:css && cross-env NODE_ENV=production rolldown -c rolldown.config.ts && tsc -p tsconfig.build.json",
    "dev:css": "postcss ./src/web/assets/css/styles.tailwind.css -o ./src/web/assets/css/styles.css --watch",
    "dev:rolldown": "cross-env NODE_ENV=development rolldown -c rolldown.config.ts --watch",
    "dev": "pnpm run --parallel \"/^dev:(css|rolldown)/\"",
    "build:css": "postcss ./src/web/assets/css/styles.tailwind.css -o ./src/web/assets/css/styles.css",
    "test": "vitest",
    "lint": "oxlint src && pnpm typecheck",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@evolu/sqlite-wasm": "^2.2.4",
    "@preact/signals": "^2.8.1",
    "bippy": "^0.5.30",
    "preact": "^10.28.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "postcss-cli": "^11.0.1",
    "react": "*",
    "react-dom": "*",
    "rolldown": "^1.0.0-rc.6",
    "tailwind-merge": "^3.5.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "access": "public"
  }
}