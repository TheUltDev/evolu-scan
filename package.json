{
  "name": "root",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @evolu/scan build",
    "dev": "pnpm --filter @evolu/scan dev",
    "lint": "pnpm -r lint",
    "lint:all": "oxlint .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@evolu/common": "catalog:",
    "@playwright/test": "latest",
    "@types/node": "catalog:",
    "oxlint": "latest",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@evolu/sqlite-wasm",
      "@playwright/test"
    ],
    "overrides": {
      "@jridgewell/gen-mapping": "0.3.13",
      "@jridgewell/sourcemap-codec": "1.5.5",
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:"
    }
  }
}